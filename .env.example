# PostgreSQL 데이터베이스 URL (Neon 사용 시 예시)
# https://neon.tech 에서 무료 DB 생성 후 복사
DATABASE_URL=postgresql://username:password@ep-xxxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require

# 세션 암호화 키 (임의의 긴 문자열 - openssl rand -hex 32 로 생성)
SESSION_SECRET=your-very-long-random-secret-key-here

# 네이버 OAuth (선택 - 로그인 기능 사용 시)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=https://your-domain.vercel.app/api/auth/naver/callback

# 카카오 OAuth (선택 - 로그인 기능 사용 시)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=https://your-domain.vercel.app/api/auth/kakao/callback

# 구글 OAuth (선택 - 로그인 기능 사용 시)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.vercel.app/api/auth/google/callback

# Google Cloud Storage (선택 - 파일 업로드 기능 사용 시)
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
