modules = ["nodejs-20", "postgresql-16", "python-3.11", "web"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["unzip"]

[[ports]]
localPort = 5000

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
integrations = ["javascript_object_storage:2.0.0", "javascript_log_in_with_replit:2.0.0"]
expertMode = true

[userenv]

[userenv.development]
NAVER_CALLBACK_URL = "https://df13948f-7958-4c63-9d19-168bb3ded2ff-00-38vjhwq42ht1k.picard.replit.dev/api/auth/naver/callback"
KAKAO_CALLBACK_URL = "https://df13948f-7958-4c63-9d19-168bb3ded2ff-00-38vjhwq42ht1k.picard.replit.dev/api/auth/kakao/callback"
GOOGLE_CALLBACK_URL = "https://df13948f-7958-4c63-9d19-168bb3ded2ff-00-38vjhwq42ht1k.picard.replit.dev/api/auth/google/callback"

[objectStorage]
defaultBucketID = "replit-objstore-71f7312d-4ef2-44df-8eaa-d3c8f9517888"
