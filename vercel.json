{
  "version": 2,
  "buildCommand": "npx vite build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/objects/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/img/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|objects|img).*)",
      "destination": "/index.html"
    }
  ]
}
