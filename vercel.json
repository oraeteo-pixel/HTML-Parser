{
  "version": 2,
  "buildCommand": "npx vite build && cp -r client/src/assets/img dist/public/img",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "server/**,shared/**,node_modules/@neondatabase/**,node_modules/drizzle-orm/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/objects/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|objects|img).*)",
      "destination": "/index.html"
    }
  ]
}
