{
  "version": 2,
  "buildCommand": "bash build-vercel.sh",
  "outputDirectory": "dist/public",
  "functions": {
    "api/handler.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler.js"
    },
    {
      "source": "/objects/:path*",
      "destination": "/api/handler.js"
    },
    {
      "source": "/((?!api|objects|img).*)",
      "destination": "/index.html"
    }
  ]
}
